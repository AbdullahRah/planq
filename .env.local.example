NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenRouter. Every model call routes through this one key (lib/claude.ts).
# Per-stage model ids default in lib/claude.ts and can be overridden below
# without a code change. Any OpenRouter model with image input and structured
# output support works.
OPENROUTER_API_KEY=
# PLANQ_MODEL_APPLICABILITY=anthropic/claude-haiku-5.5
# PLANQ_MODEL_EXTRACTION=openai/gpt-6-luna
# PLANQ_MODEL_VERIFIER=anthropic/claude-sonnet-5.5
# Reasoning strength for stages that think: low, medium, high, or off for a
# model with no reasoning mode.
# PLANQ_REASONING_EFFORT=medium
# Drawings are sent only to providers that do not train on prompts. Set to
# allow if a model has no such endpoint.
# PLANQ_DATA_COLLECTION=deny
# Fallback models OpenRouter tries when a stage's model is unavailable,
# comma-separated, or none. Defaults are in lib/claude.ts.
# PLANQ_FALLBACK_EXTRACTION=anthropic/claude-sonnet-5.5

# Claude API, used directly when OpenRouter is out of credit or over a cap, so
# reviews keep running. Optional; without it an OpenRouter credit error pauses
# the review until a top-up. A key not scoped to one workspace needs the id.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

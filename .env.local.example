NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Claude API. Every analysis stage routes through this one key; per-stage model
# ids live in lib/claude.ts, not here (PLANQ_SPEC.md §2.3). An `ant auth login`
# profile also works, in which case leave this unset.
ANTHROPIC_API_KEY=
# Required only when the key is org-scoped rather than workspace-scoped. Without
# it such a key 400s on every call asking for this header.
ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# OpenRouter still backs the legacy vision extraction in lib/extract.ts. It goes
# away when S2 moves extraction onto Claude vision (PLANQ_SPEC.md §S2).
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.5-flash-lite
REASONING_MODEL=google/gemini-2.5-flash-lite

# Verbose per-stage logging.
PLANQ_DEBUG=

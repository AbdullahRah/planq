NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
OPENROUTER_API_KEY=your_openrouter_key
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
REASONING_MODEL=openai/gpt-oss-120b:free
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional comma-separated fallback chains used when the primary returns
# empty or is rate-limited.
# REASONING_MODEL_CHAIN=openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Extend document extraction — PARKED, not built or deployed. See
# extend/README.md to restore. Leave both unset: EXTRACT_PROVIDER=extend now
# returns a 500 rather than silently falling back to the vision path.
# EXTEND_API_KEY=
# EXTRACT_PROVIDER=vision
# Optional override for the parked Python function URL.
# EXTEND_FUNCTION_URL=

# TypeSafe (Jev) — verification gate for model-authored findings (lib/verify.ts).
# Create a key at https://console.typesafe.ai/keys. Server-side only; never
# expose it to the browser. When set, every LLM compliance finding is checked
# against the text of the section it cites before it can reach a report.
TYPESAFE_API_KEY=
# Model to judge with. "jev-latest" tracks TypeSafe's current flagship; pin an
# exact version (e.g. jev-1.13) to freeze verification behaviour.
TYPESAFE_MODEL=jev-latest
# Set to "off" to disable the gate explicitly. It is on whenever a key is
# present, and can only remove or downgrade findings, never add one.
TYPESAFE_VERIFY=
